<Project Sdk="Microsoft.NET.Sdk">

  <!--
    LimbusPy kernel: the ONLY compiled artifact of LimbusPy.
    Deliberately thin - all protocol/codec/handle/reflection logic lives in
    LimbusPy.Bridge.Core (Unity-free, covered by tools/conformance.py). This project only
    wires that core to Unity/IL2CPP, Harmony and the Python process.

    No compile-time dependency on Lethe or ModularSkillScripts on purpose: both are optional
    peers reached through reflection (see Glue/), so a version bump of either cannot break
    the kernel's assembly load.
  -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>10</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>LimbusPy.Bridge</AssemblyName>
    <RootNamespace>LimbusPy.Bridge</RootNamespace>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <!-- Game install used for reference assemblies; override with -p:GameDir=... -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Limbus Company</GameDir>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
    <InteropDir>$(GameDir)\BepInEx\interop</InteropDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LimbusPy.Bridge.Core\LimbusPy.Bridge.Core.csproj" />
    <ProjectReference Include="..\LimbusPy.Bridge.Harmony\LimbusPy.Bridge.Harmony.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx.Core">
      <HintPath>$(BepInExCore)\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(BepInExCore)\BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(BepInExCore)\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(InteropDir)\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(InteropDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(InteropDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
