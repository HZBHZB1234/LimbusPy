<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Kernel-side harness with no Unity dependency: it speaks LPCP on a real named pipe and is
    driven by python/tools/conformance.py. This is how the C# half is verified without the game.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>10</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>LimbusPy.Bridge.Tests</AssemblyName>
    <RootNamespace>LimbusPy.Bridge.Tests</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Limbus Company</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\kernel\LimbusPy.Bridge.Core\LimbusPy.Bridge.Core.csproj" />
    <ProjectReference Include="..\..\kernel\LimbusPy.Bridge.Harmony\LimbusPy.Bridge.Harmony.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      HarmonyX needs MonoMod at runtime. In-game BepInEx/core provides them; the harness runs
      standalone, so it copies the exact same files it will use in-game.
    -->
    <None Include="$(GameDir)\BepInEx\core\0Harmony.dll" Link="0Harmony.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(GameDir)\BepInEx\core\MonoMod.RuntimeDetour.dll" Link="MonoMod.RuntimeDetour.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(GameDir)\BepInEx\core\MonoMod.Utils.dll" Link="MonoMod.Utils.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(GameDir)\BepInEx\core\MonoMod.Backports.dll" Link="MonoMod.Backports.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(GameDir)\BepInEx\core\MonoMod.ILHelpers.dll" Link="MonoMod.ILHelpers.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
